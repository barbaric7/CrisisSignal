# Copy this file to .env (same folder level as this file) and fill in.

# Supabase: Project -> Connect -> "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
# If the password has special characters (@ # / ? :), URL-encode them.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres

# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# Set to false only if SACHET shows SSL certificate errors
SACHET_VERIFY_SSL=true
# SACHET_RSS_URL=
